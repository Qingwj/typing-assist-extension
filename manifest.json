{
  "manifest_version": 3,
  "name": "模拟键入助手",
  "version": "0.2.0",
  "description": "把预填文本逐字符模拟键入到禁止粘贴的网页输入框",
  "action": {
    "default_title": "显示/隐藏模拟键入面板"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/core.js", "src/typing.js", "src/panel.js", "src/controller.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
